
<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>SAFe Banking Software</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f7fb;
      color: #1f2937;
    }

    /* NAVBAR */
    .navbar {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: #0f172a;
      padding: 15px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 3px 15px rgba(0,0,0,0.2);
    }

    .logo {
      color: white;
      font-size: 22px;
      font-weight: bold;
    }

    .logo span {
      color: #38bdf8;
    }

    .nav-links {
      display: flex;
      gap: 25px;
      list-style: none;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
      font-size: 15px;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: #38bdf8;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      padding: 150px 7% 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 50px;
      background:
        linear-gradient(135deg, #0f172a, #1e3a8a);
      color: white;
    }

    .hero-content {
      max-width: 650px;
    }

    .hero h1 {
      font-size: 52px;
      line-height: 1.15;
      margin-bottom: 25px;
    }

    .hero h1 span {
      color: #38bdf8;
    }

    .hero p {
      font-size: 19px;
      line-height: 1.7;
      color: #dbeafe;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      padding: 14px 25px;
      background: #38bdf8;
      color: #082f49;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn:hover {
      transform: translateY(-3px);
      background: #7dd3fc;
    }

    .hero-card {
      width: 380px;
      padding: 30px;
      border-radius: 20px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.25);
      backdrop-filter: blur(10px);
      text-align: center;
    }

    .hero-card .bank-icon {
      font-size: 80px;
      margin-bottom: 20px;
    }

    .hero-card h2 {
      margin-bottom: 15px;
    }

    .hero-card p {
      font-size: 15px;
      margin: 0;
    }

    /* GENERAL */
    .section {
      padding: 90px 7%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 50px;
    }

    .section-title h2 {
      font-size: 38px;
      color: #0f172a;
      margin-bottom: 12px;
    }

    .section-title p {
      color: #64748b;
      font-size: 17px;
    }

    /* STATS */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-top: -50px;
      position: relative;
    }

    .stat-card {
      background: white;
      padding: 25px;
      text-align: center;
      border-radius: 14px;
      box-shadow: 0 8px 25px rgba(15,23,42,0.12);
    }

    .stat-card h3 {
      font-size: 35px;
      color: #2563eb;
    }

    .stat-card p {
      margin-top: 8px;
      color: #64748b;
    }

    /* ART CARDS */
    .art-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
    }

    .art-card {
      background: white;
      border-radius: 16px;
      padding: 30px 25px;
      box-shadow: 0 8px 25px rgba(15,23,42,0.08);
      transition: 0.3s;
      border-top: 5px solid #2563eb;
    }

    .art-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 15px 35px rgba(15,23,42,0.15);
    }

    .art-icon {
      font-size: 42px;
      margin-bottom: 20px;
    }

    .art-card h3 {
      margin-bottom: 12px;
      color: #0f172a;
    }

    .art-card p {
      color: #64748b;
      line-height: 1.6;
    }

    /* ROLES */
    .roles-section {
      background: #eaf2ff;
    }

    .roles-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
    }

    .role-card {
      background: white;
      padding: 28px;
      border-radius: 15px;
      text-align: center;
      box-shadow: 0 7px 20px rgba(0,0,0,0.08);
      transition: 0.3s;
    }

    .role-card:hover {
      transform: scale(1.04);
    }

    .role-icon {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .role-card h3 {
      margin-bottom: 12px;
      color: #1d4ed8;
    }

    .role-card p {
      color: #64748b;
      line-height: 1.6;
    }

    /* PI PLANNING */
    .workflow {
      max-width: 1000px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      gap: 15px;
      position: relative;
    }

    .workflow::before {
      content: "";
      position: absolute;
      top: 40px;
      left: 8%;
      right: 8%;
      height: 4px;
      background: #bfdbfe;
      z-index: 0;
    }

    .step {
      position: relative;
      z-index: 1;
      width: 20%;
      text-align: center;
    }

    .step-number {
      width: 80px;
      height: 80px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #2563eb;
      color: white;
      font-size: 28px;
      font-weight: bold;
      border: 7px solid #dbeafe;
    }

    .step h3 {
      margin-top: 18px;
      color: #0f172a;
      font-size: 17px;
    }

    .step p {
      margin-top: 10px;
      color: #64748b;
      font-size: 14px;
      line-height: 1.5;
    }

    /* RISKS */
    .risk-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .risk-card {
      background: white;
      border-radius: 15px;
      padding: 25px;
      border-left: 6px solid #ef4444;
      box-shadow: 0 8px 25px rgba(15,23,42,0.08);
    }

    .risk-card h3 {
      color: #b91c1c;
      margin-bottom: 15px;
    }

    .risk-card p {
      color: #64748b;
      line-height: 1.6;
      margin-bottom: 10px;
    }

    .impact {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
      background: #fee2e2;
      color: #b91c1c;
    }

    /* DASHBOARD */
    .dashboard {
      background: #0f172a;
      color: white;
    }

    .dashboard .section-title h2 {
      color: white;
    }

    .dashboard .section-title p {
      color: #cbd5e1;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .dashboard-card {
      background: #1e293b;
      padding: 28px;
      border-radius: 15px;
      border: 1px solid #334155;
    }

    .dashboard-card h3 {
      margin-bottom: 20px;
      color: #7dd3fc;
    }

    .progress {
      height: 10px;
      background: #334155;
      border-radius: 10px;
      overflow: hidden;
      margin: 15px 0;
    }

    .progress-bar {
      height: 100%;
      background: #38bdf8;
      border-radius: 10px;
    }

    .dashboard-card p {
      color: #cbd5e1;
    }

    /* FOOTER */
    footer {
      background: #020617;
      color: #94a3b8;
      text-align: center;
      padding: 30px;
    }

    footer strong {
      color: #38bdf8;
    }

    /* MOBILE */
    @media (max-width: 1000px) {
      .stats,
      .art-grid,
      .roles-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .risk-grid,
      .dashboard-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        flex-direction: column;
        text-align: center;
      }

      .workflow {
        flex-direction: column;
        align-items: center;
      }

      .workflow::before {
        display: none;
      }

      .step {
        width: 100%;
        max-width: 350px;
      }
    }

    @media (max-width: 650px) {
      .navbar {
        padding: 15px 5%;
      }

      .nav-links {
        display: none;
      }

      .hero {
        padding: 130px 5% 70px;
      }

      .hero h1 {
        font-size: 38px;
      }

      .hero-card {
        width: 100%;
      }

      .section {
        padding: 65px 5%;
      }

      .stats,
      .art-grid,
      .roles-grid {
        grid-template-columns: 1fr;
      }

      .section-title h2 {
        font-size: 30px;
      }
    }
  </style>

</head>

